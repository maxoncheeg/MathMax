<UserControl x:Class="MathMax.Desktop.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MathMax.Desktop.Views"
             xmlns:vm="clr-namespace:MathMax.Desktop.ViewModels"
             mc:Ignorable="d"
             FontFamily="Consolas"
             FontSize="16"
             d:DataContext="{d:DesignInstance vm:HostViewModel}"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />

            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True">
                <Label DockPanel.Dock="Top">Статус:</Label>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextAlignment="Center"></TextBlock>
                <Label DockPanel.Dock="Top">Помощники:</Label>

                
                <Button DockPanel.Dock="Bottom" FontSize="20" Padding="10" 
                        Command="{Binding StartCommand}">
                    Начать выполнение
                </Button>

                <TextBox DockPanel.Dock="Bottom" TextAlignment="Center" Margin="10, 0, 10, 10" Text="{Binding Points}"></TextBox>
                <Label DockPanel.Dock="Bottom">Количество точек:</Label>
                
                <ListBox Background="AliceBlue" DockPanel.Dock="Bottom" ItemsSource="{Binding Helpers}">
                </ListBox>


            </DockPanel>
        </Grid>

        <UserControl Background="#fafafa" Grid.Column="1" Content="{Binding PiVisual}"></UserControl>
    </Grid>
</UserControl>